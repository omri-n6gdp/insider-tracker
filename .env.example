# Trading 212 read-only API key (T212 app -> Settings -> API).
# Copy this file to .env and paste your key. The .env file is git-ignored.
TRADING212_API_KEY=
# Optional: only if your setup uses a key:secret pair (HTTP Basic auth).
TRADING212_API_SECRET=
# Required by the SEC: a name + your contact email
SEC_USER_AGENT=insider-tracker (personal research) you@example.com
